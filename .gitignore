# Python
backend/.venv/
**/__pycache__/
*.pyc
backend/.env
backend/.pytest_cache/

# Data (sqlite db and the trained strength model are local-only,
# regenerable from real play data / a training run; the directory itself
# is tracked via .gitkeep)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db-journal
backend/data/*.joblib
backend/data/*_meta.json
!backend/data/.gitkeep

# Stockfish binary -- downloaded, not committed (platform-specific)
backend/vendor/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/tsconfig.tsbuildinfo

# OS
.DS_Store
Thumbs.db
