# Python (the FastAPI backend is archived under archive/ — see archive/README.md)
archive/backend/.venv/
**/__pycache__/
*.pyc
archive/backend/.env
archive/backend/.pytest_cache/

# Data (sqlite db and the trained strength model are local-only,
# regenerable from real play data / a training run; the directory itself
# is tracked via .gitkeep)
archive/backend/data/*.db
archive/backend/data/*.db-wal
archive/backend/data/*.db-shm
archive/backend/data/*.db-journal
archive/backend/data/*.joblib
archive/backend/data/*_meta.json
!archive/backend/data/.gitkeep

# Stockfish binary -- downloaded, not committed (platform-specific)
archive/backend/vendor/

# Node / archived React frontend
archive/frontend/node_modules/
archive/frontend/dist/
archive/frontend/.env
archive/frontend/tsconfig.tsbuildinfo

# The one live app is web/ — it has its own web/.gitignore

# OS
.DS_Store
Thumbs.db
