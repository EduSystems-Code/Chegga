# Your Chess.com username (the account this whole app analyzes).
CHESS_COM_USERNAME=

# Chess.com's API asks clients to identify themselves in the User-Agent.
# Put an email or a URL you control here -- this is sent to Chess.com, not
# stored anywhere else.
CHESS_COM_CONTACT=

# Full path to a Stockfish executable. Download from stockfishchess.org --
# the binary itself is never committed to this repo (platform-specific).
# Windows example: C:\stockfish\stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=

# Engine tuning -- safe defaults, all overridable.
STOCKFISH_DEPTH=14
STOCKFISH_MOVETIME_MS=300
STOCKFISH_MULTIPV=3
STOCKFISH_THREADS=2

# Unused until Phase 3 (Claude coaching). Leave blank for now.
ANTHROPIC_API_KEY=

# Relative to backend/ (where uvicorn/alembic run from). The file is
# gitignored; only this directory's .gitkeep is tracked.
DATABASE_URL=sqlite:///./data/chegga.db
